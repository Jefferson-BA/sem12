            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Incluye propietario creado', () => pm.expect(pm.response.json().some(x => x.idPropietario === Number(pm.collectionVariables.get('ownerId')))).to.be.true);"
            ]
