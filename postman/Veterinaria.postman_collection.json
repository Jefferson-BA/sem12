{
  "info": {
    "name": "Semana 12 Gestión Veterinaria",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar completa en orden sobre datos de laboratorio. Crea y elimina sus propios registros. No modifica los datos iniciales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5227"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith('01 ')) {",
          "const id=Date.now().toString()+Math.floor(Math.random()*100000);",
          "const dni=String(10000000+Math.floor(Math.random()*80000000));",
          "pm.collectionVariables.set('runId',id); pm.collectionVariables.set('dni',dni);",
          "pm.collectionVariables.set('otroDni',String(Number(dni)+1));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Crear propietario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/propietarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Propietario Postman\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"987654321\",\n  \"email\": \"lab-{{runId}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('ownerId', pm.response.json().idPropietario);",
              "pm.test('Location del recurso', () => pm.expect(pm.response.headers.get('Location')).to.match(/api\\//i));"
            ]
          }
        }
      ]
    },
    {
