# Copia estos valores a .env para ejecutar la API local conectada a Neon.
# Sustituye todos los marcadores. No publiques tu .env.
# Pega la URI completa de Connect en Neon, sin el comando psql.
LocalDatabase__Enabled=false
ConnectionStrings__DefaultConnection=postgresql://TU_USUARIO:TU_PASSWORD@ep-TU-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
Cors__AllowedOrigins__0=http://localhost:5227
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5227
